# Copie para .env e preencha. O .env fica fora da raiz web e nunca é versionado.

APP_NAME="Notification Service"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://notify.example.com

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

# Logs JSON lines, um arquivo por dia, apagados depois de LOG_DAILY_DAYS dias
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# Sem banco: sessão em memória e rate limit em cache de arquivo (storage/framework/cache)
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Limites da API
RATE_LIMIT_PER_MINUTE=30
MAX_BODY_BYTES=262144


# Chaves de API: nome|sha256|canais|destinatários, separadas por ponto e vírgula.
# Gere com: php artisan keys:generate <nome> --channels=telegram --to=eduardo
API_KEYS=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org
# Aliases de destinatário no formato alias:chat_id, separados por vírgula
TELEGRAM_RECIPIENTS=eduardo:000000000

# WhatsApp (Evolution API)
WHATSAPP_API_BASE=http://localhost:8080
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE=notify-teste
# Aliases de destinatário no formato alias:número (DDI+DDD+número, só dígitos)
WHATSAPP_RECIPIENTS=eduardo:5500000000000
