# Copie para .env (fora da raiz web) e preencha. Nunca versione o .env.

APP_ENV=production
APP_TIMEZONE=America/Bahia

# Caminho do banco SQLite (relativo à raiz do projeto ou absoluto)
DB_PATH=storage/database.sqlite

# Logs JSON lines em storage/logs, um arquivo por dia
LOG_RETENTION_DAYS=14

# Entregas finalizadas são removidas depois deste prazo
DELIVERY_RETENTION_DAYS=30

# Limites da API
RATE_LIMIT_PER_MINUTE=60
MAX_BODY_BYTES=65536

# Swagger UI em /docs e especificação em /openapi.yaml
DOCS_ENABLED=true

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org
# Aliases de destinatário: alias:chat_id separados por vírgula
TELEGRAM_RECIPIENTS=eduardo:000000000

# Notion
NOTION_TOKEN=
NOTION_API_BASE=https://api.notion.com
NOTION_VERSION=2022-06-28

# Job jobs:linkedin-drafts
LINKEDIN_PARENT_PAGE_ID=
LINKEDIN_DRAFTS_RECIPIENT=eduardo
LINKEDIN_DRAFTS_CHANNEL=telegram
